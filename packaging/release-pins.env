# Build-time pins for the Linux release artifacts, in ONE place because two forges now read them.
#
# arm64 is built natively on GitHub and amd64 natively on Forgejo (nothing is emulated), so these
# values are consumed by two workflows on two hosts. Inline copies would drift the first time one
# was bumped and the other was not, and the failure would surface as an architecture-dependent
# release rather than as a diff.
#
# The interpreter, sunxi-tools and pyusb pins are NOT here: they live in
# src/dreame_valetudo/constants.py with the rest of this project's deliberate pins, and the build
# reads them from there. One pin, one home — duplicating them here to look tidy would create the
# exact drift this file exists to prevent.
#
# Sourced, not executed. Renovate reads the annotations here — see the managerFilePatterns entry
# in .renovaterc.json.

# renovate: datasource=pypi depName=pyinstaller
PYINSTALLER="6.22.3"

# ONE multi-arch pin, not one per arch: buildx's --platform picks the arch out of the index. Quay
# publishes the per-arch images minutes apart and assembles this index only once all of them exist,
# so a separate pin per arch let Renovate open a bump between the two and skew the toolchain across
# the release. The index digest freezes every arch's image at once.
# renovate: datasource=docker depName=quay.io/pypa/manylinux_2_28
MANYLINUX="quay.io/pypa/manylinux_2_28:2026.11.07-1@sha256:8ba480e6fdcd18967512389b0d5aa32fda7d4458631eeef3acd1e83133c54a53"

# nfpm packages the binaries. Pinned image; its digest IS the integrity check.
# renovate: datasource=docker depName=goreleaser/nfpm
NFPM="goreleaser/nfpm:v2.49.0@sha256:9ea46a59c4d055ef7071b22f3520b53e8dad98e18043b2f881b53bd7ffec634e"

# The same base package-smoke.Dockerfile installs the .deb into, so the standalone bundle is proven
# against the identical userland rather than a second, differently-aged one.
# renovate: datasource=docker depName=ubuntu-26.04-current packageName=ubuntu
SMOKE_BASE="ubuntu:26.04@sha256:065aa8626841f16057b78b027b464cd59c4fac36c204c72dcbf48d66f5fa8a96"

# The vendored shared standard (SisyphusMD/project-standard). Renovate watches its tags and opens
# the bump; re-vendoring the files is a separate act, and the invariant test refuses a pin that
# disagrees with STANDARD.lock — so a bumped pin can never be mistaken for re-synced files.
#
# Stored without the leading `v` the tag carries, like the CPython pin above: the shared matchString
# requires a digit first, and a value starting `v` matches nothing at all, silently.
# renovate: datasource=gitea-tags depName=SisyphusMD/project-standard
PROJECT_STANDARD="0.1.36"
