# Runtime / device-specific artifacts. The default ~/dreame-valetudo/{work,backups} layout is
# outside the repo; these also protect an accidental DREAME_WORK/DREAME_BACKUPS override here.
dreame-valetudo-work/
work/
backups/
bench/
cache/
dist/
state/
robots/
recon/
fw/
sunxi-tools/

# Never commit device identity / keys / backups.
id_dreame*
*.pem
config.txt
check.txt
*-backup-*/
*.img
*.bin
*.tar
*.tar.gz
*.dd.gz
dreame_samples.zip
dreame_recovery_backup.zip
*_fel_ng*.zip
recovery-provenance.json
.recovery-capture-refresh
.dreame-valetudo-image.json
.private.json
dreame-*-stock-recovery/

# Python bytecode from the helpers.
__pycache__/
*.pyc

# Tool caches (each tool self-ignores these, but pin them explicitly).
.venv/
.pytest_cache/
.ruff_cache/

# Packaging build outputs (PyInstaller, pkgbuild, deb, rpm).
build/
/out/
/out-*/
/homebrew-smoke-result/
/package-smoke-*/
*.pkg
*.deb
*.rpm
root/
/sunxi-fel
/notes.md
notary.p8
*.p12
